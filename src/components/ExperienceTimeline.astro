---
import { profile } from '../data/profile';
const placeholder = profile.experience.length === 0;
const entries = placeholder ? [
  { period: 'YYYY — Present', role: 'Your current chapter', company: 'Current role', description: 'Add your role, team and the problems you are working on here.' },
  { period: 'YYYY — YYYY', role: 'What came before', company: 'Previous experience', description: 'A place for the responsibilities, decisions and lessons that shaped your work.' },
  { period: 'YYYY', role: 'Where it started', company: 'First milestone', description: 'Add an early role, a research chapter or a meaningful learning milestone.' },
] : profile.experience;
---
<div class="experience-timeline" data-timeline>
  <div class="timeline-glass" data-timeline-glass aria-hidden="true"></div>
  {placeholder && <p class="timeline-notice text-sm leading-relaxed">Timeline preview · Dates and experience are placeholders, ready for your real story.</p>}
  <ol class="timeline-list">
    {entries.map((entry, index) => <li class="timeline-item" data-timeline-item>
      <div class="timeline-date"><span class="section-index">{String(index + 1).padStart(2, '0')}</span><p>{entry.period}</p></div>
      <span class="timeline-node" aria-hidden="true"></span>
      <div class="timeline-copy" data-reveal>
        <p class="section-index text-body">{entry.company}{placeholder && ' / Placeholder'}</p>
        <h3 class="mt-3 text-2xl tracking-tight sm:text-3xl">{entry.role}</h3>
        <p class="mt-4 max-w-xl text-body leading-relaxed">{entry.description}</p>
      </div>
    </li>)}
  </ol>
</div>
<style>
  .experience-timeline { --timeline-accent: #1d35ff; position: relative; isolation: isolate; margin-top: 56px; }
  .timeline-glass { position: absolute; z-index: -1; top: 22%; left: 2%; width: clamp(120px,15vw,230px); aspect-ratio: 1; border: 1px solid rgb(255 255 255 / .85); border-radius: 50%; background: rgb(255 255 255 / .08); box-shadow: inset 5px 7px 14px rgb(255 255 255 / .85), inset -3px -5px 12px rgb(0 0 0 / .09), 0 8px 22px rgb(0 0 0 / .025); backdrop-filter: blur(2px); pointer-events: none; }
  .timeline-glass::after { content: ''; position: absolute; inset: 8px; border: 1px solid rgb(255 255 255 / .55); border-radius: inherit; box-shadow: inset -2px -2px 4px rgb(0 0 0 / .035); }
  .timeline-notice { max-width: 40em; padding: 16px 20px; margin-bottom: 40px; border-radius: var(--radius-card); background: var(--color-surface); color: var(--color-body); }
  .timeline-list { position: relative; }
  .timeline-list::before, .timeline-list::after { content: ''; position: absolute; top: var(--timeline-start,10px); height: var(--timeline-length,calc(100% - 70px)); left: calc(25% + 8px); width: 1px; background: var(--color-line); }
  .timeline-list::after { background: var(--timeline-accent); transform: scaleY(var(--timeline-progress, 1)); transform-origin: top; }
  .timeline-item { position: relative; display: grid; grid-template-columns: 25% 48px 1fr; padding-bottom: 64px; }
  .timeline-date { display: flex; flex-direction: column; gap: 16px; padding-right: 20px; font-size: 16px; }
  .timeline-node { position: relative; z-index: 1; margin-top: 7px; width: 17px; height: 17px; background: var(--color-canvas); border: 1px solid var(--color-line); border-radius: 50%; transition: background .5s, border-color .5s, box-shadow .5s; }
  .timeline-node::after { content: ''; position: absolute; inset: -1px; border: 1px solid var(--timeline-accent); border-radius: inherit; opacity: 0; pointer-events: none; }
  [data-reached] .timeline-node { background: var(--timeline-accent); border-color: var(--timeline-accent); box-shadow: 0 0 0 6px rgb(29 53 255 / .07); }
  [data-reached] .timeline-node::after { animation: milestone-ripple 1.1s var(--ease-gallery) both; }
  @keyframes milestone-ripple { from { opacity: .45; transform: scale(1); } to { opacity: 0; transform: scale(3.4); } }
  .timeline-copy { padding-bottom: 32px; border-bottom: 1px solid var(--color-line); }
  @media (max-width: 767px) {
    .timeline-glass { left: auto; right: 0; width: 120px; opacity: .5; }
    .timeline-item { grid-template-columns: 32px 1fr; padding-bottom: 36px; }
    .timeline-date { grid-column: 2; flex-direction: row; align-items: center; gap: 12px; margin-bottom: 20px; font-size: 14px; }
    .timeline-node { grid-row: 1; grid-column: 1; margin-top: 3px; }
    .timeline-copy { grid-column: 2; }
    .timeline-list::before, .timeline-list::after { left: 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .timeline-glass, .timeline-copy { transform: none !important; }
    .timeline-node::after { animation: none; }
  }
</style>
