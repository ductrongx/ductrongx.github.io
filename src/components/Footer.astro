---
import { Image } from 'astro:assets';
import { profile } from '../data/profile';
import { education } from '../data/education';
import ArrowIcon from './ArrowIcon.astro';
import TiltCard from './TiltCard.astro';
---
<footer class="site-footer">
  <div class="gallery-shell footer-main">
    <div class="footer-grid grid gap-12 md:grid-cols-[1fr_2fr]">
      <div data-reveal>
        <TiltCard>
        <div class="footer-identity">
        <a href="/#top" class="footer-brand" aria-label="Duc — Back to top">DUC<span>.</span></a>
        <p class="mt-5 text-sm text-body">{profile.name}<br />{profile.role}</p>
        </div>
        </TiltCard>
      </div>
      <section aria-labelledby="education-title">
        <h2 id="education-title" class="section-index mb-6" data-reveal>Education</h2>
        <ul class="education-list">
          {education.map(institution => <li data-reveal>
            <a href={institution.url} class="education-link">
              <div class="education-logo">
                <Image src={institution.logo} alt="" widths={[220,332]} sizes="(max-width: 767px) 200px, 220px" format="webp" loading="lazy" />
              </div>
              <div><p class="education-name">{institution.name}</p><p class="mt-3 text-xs text-body">{institution.shortName} · Ho Chi Minh City, Vietnam</p></div>
              <span class="education-arrow"><ArrowIcon /></span>
            </a>
          </li>)}
        </ul>
      </section>
    </div>
    <div class="footer-bottom">
      <p>© {new Date().getFullYear()} {profile.name}</p>
      <p class="footer-note">Always learning. Always building.</p>
      <a class="footer-top" href="#top" aria-label="Back to top"><ArrowIcon direction="up" /></a>
    </div>
  </div>
</footer>
<style>
  .site-footer { --color-body: #bfc3cf; --color-line: #2b2e3a; --color-focus: #a9b6ff; background: var(--color-ink); color: var(--color-surface); }
  .footer-main { padding-block: clamp(48px,5vw,88px) 32px; }
  .footer-brand { display: inline-block; font-size: 36px; letter-spacing: -.045em; line-height: 1; }
  .footer-brand span { color: var(--color-focus); }
  .footer-identity { width: 100%; padding-block: 8px; transform: translateZ(30px); }
  .education-list { display: grid; gap: 24px; }
  .education-link { display: grid; grid-template-columns: minmax(140px,.8fr) 1.5fr auto; align-items: center; gap: clamp(24px,3vw,56px); padding-block: 24px; border-block: 1px solid var(--color-line); }
  .education-logo { width: min(100%,220px); }
  .education-logo :global(img) { width: 100%; height: auto; }
  .education-name { max-width: 23em; font-size: clamp(18px,1.5vw,26px); line-height: 1.3; letter-spacing: -.025em; transition: color .3s; }
  .education-arrow { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--color-control); transition: color .3s, background .3s, transform .6s var(--ease-gallery); }
  .education-link:is(:hover,:focus-visible) .education-name { color: var(--color-focus); }
  .education-link:is(:hover,:focus-visible) .education-arrow { background: var(--color-accent); color: var(--color-on-accent); transform: rotate(45deg); }
  .footer-bottom { display: grid; grid-template-columns: 1fr 2fr auto; align-items: center; gap: 24px; margin-top: clamp(48px,5vw,88px); font-size: 12px; }
  .footer-top { display: grid; place-items: center; width: 52px; height: 52px; margin-right: 76px; border-radius: 50%; background: var(--color-surface); color: var(--color-ink); transition: background .3s, color .3s; }
  .footer-top:hover { background: var(--color-accent); color: var(--color-surface); }
  @media (max-width: 1023px) {
    .education-link { grid-template-columns: 1fr auto; gap: 20px; }
    .education-logo { grid-column: 1 / -1; }
  }
  @media (max-width: 767px) {
    .education-logo { width: 200px; }
    .footer-bottom { grid-template-columns: 1fr auto; gap: 12px; }
    .footer-note { grid-column: 1; }
    .footer-top { grid-column: 2; grid-row: 1 / 3; margin-right: 72px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .footer-identity { transform: none; }
    .education-arrow, .education-name, .footer-top { transition: none; }
  }
</style>
