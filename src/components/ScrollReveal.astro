---
interface Props {
  text: string;
  tag?: 'p' | 'h2' | 'h3';
  class?: string;
}
const { text, tag: Tag = 'p', class: className } = Astro.props;
---
<Tag class={className} data-scroll-reveal>
  <span class="sr-only">{text}</span>
  <span aria-hidden="true">{text.split(/(\s+)/).map(word => word.trim()
    ? <span class="scroll-reveal-word" data-scroll-word>{word}</span>
    : word)}</span>
</Tag>
<style>
  .scroll-reveal-word { display: inline-block; transform-origin: 50% 100%; }
  @media (prefers-reduced-motion: reduce) {
    .scroll-reveal-word { opacity: 1 !important; filter: none !important; transform: none !important; }
  }
</style>
