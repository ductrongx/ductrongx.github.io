---
import SlideText from './SlideText.astro';
import ScrollReveal from './ScrollReveal.astro';
import ArrowIcon from './ArrowIcon.astro';
import LinkedInIcon from '../assets/icons/linkedin.svg';
import GitHubIcon from '../assets/icons/github.svg';
import KaggleIcon from '../assets/icons/kaggle.svg';
import GmailIcon from '../assets/icons/gmail.svg';
import { profile } from '../data/profile';
const socials = [{ label: 'LinkedIn', Icon: LinkedInIcon }, { label: 'GitHub', Icon: GitHubIcon }, { label: 'Kaggle', Icon: KaggleIcon }, { label: 'Gmail', Icon: GmailIcon }].map(channel => ({ ...channel, url: channel.label === 'Gmail' ? `mailto:${profile.email}` : profile.links.find(link => link.label === channel.label)?.url }));
---
<section id="about" class="hero-section gallery-shell" aria-labelledby="hero-title" data-hero>
  <div class="hero-copy">
    <p class="hero-eyebrow"><span class="hero-status" aria-hidden="true"></span><span data-scramble>AI ENGINEERING · LLM · AGENT SYSTEMS</span></p>
    <SlideText id="hero-title" tag="h1" class="hero-title" lines={["I'm Duc,", 'an AI Engineer.']} />
    <div class="hero-introduction">
      <h2>Led by curiosity.<br />Built with intention.</h2>
      <ScrollReveal class="hero-bio" text={`${profile.intro} I follow small questions, test ideas and turn what works into projects in LLM, Retrieval, and Agent Systems.`} />
    </div>
    <div class="hero-actions">
      <a class="pill-link hero-explore" href="#work" data-magnet><span>Explore Work</span><ArrowIcon direction="down" /></a>
      <nav class="hero-socials" aria-label="Find Duc online">{socials.map(({ label, Icon, url }) => url && <a href={url} aria-label={label} target={url.startsWith('https:') ? '_blank' : undefined} rel={url.startsWith('https:') ? 'noopener noreferrer' : undefined} data-magnet><Icon width={18} height={18} aria-hidden="true" fill="currentColor" /></a>)}</nav>
    </div>
    <a href="#experience" class="hero-experience-link">My experience <span aria-hidden="true">↗</span></a>
  </div>
  <div class="hero-frame" aria-hidden="true"></div>
  <div class="hero-baseline"><span>PERSONAL PORTFOLIO / {new Date().getFullYear()}</span><a href="#work">Scroll to explore <span aria-hidden="true">↓</span></a></div>
</section>
<style>
  .hero-section { display: grid; grid-template-columns: 43% minmax(0,57%); position: relative; align-items: center; min-height: 100svh; padding-top: calc(var(--spacing-scroll-offset) + 32px); padding-bottom: 76px; }
  .hero-copy { padding-block: 32px; position: relative; z-index: 2; }
  .hero-eyebrow { display: flex; align-items: center; gap: 10px; font-family: ui-monospace, monospace; font-size: clamp(9px,.7vw,12px); letter-spacing: .025em; }
  .hero-status { flex-shrink: 0; width: 6px; height: 6px; border-radius: 50%; background: #1d35ff; box-shadow: 0 0 0 4px #1d35ff0a; animation: hero-status 3s ease-in-out infinite; }
  .hero-copy :global(.hero-title) { margin-top: 30px; font-size: clamp(44px,4.3vw,84px); line-height: 1.08; letter-spacing: -.055em; font-weight: 500; }
  .hero-introduction { max-width: 390px; margin-top: 32px; padding-right: 24px; }
  .hero-introduction h2 { font-size: clamp(17px,1.3vw,23px); line-height: 1.45; letter-spacing: -.02em; }
  .hero-introduction :global(.hero-bio) { margin-top: 18px; font-size: clamp(13px,.95vw,16px); line-height: 1.85; color: var(--color-body); }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-top: 30px; }
  .hero-explore { background: #1d35ff; color: #fff; min-height: 50px; padding: 14px 22px; font-size: 12px; gap: 22px; }
  .hero-socials { display: flex; gap: 8px; }
  .hero-socials a { display: grid; place-items: center; width: 40px; height: 40px; border: 1px solid var(--color-line); background: #ffffff80; border-radius: 50%; transition: background .3s, border-color .3s; }
  .hero-socials a:hover { background: #fff; border-color: #a9b6ff; }
  .hero-experience-link { display: flex; align-items: center; gap: 20px; width: fit-content; min-height: 44px; margin-top: 12px; font-size: 11px; }
  .hero-frame { min-width: 0; width: 100%; height: clamp(420px,45vw,680px); border: 1px solid var(--color-line); border-radius: var(--radius-gallery); background: var(--color-surface); }
  .hero-baseline { position: absolute; bottom: 24px; left: 0; right: 0; display: flex; justify-content: space-between; align-items: center; gap: 20px; font-size: 10px; letter-spacing: .06em; }
  .hero-baseline a { display: flex; align-items: center; gap: 24px; min-height: 44px; font-size: 11px; letter-spacing: 0; }
  @keyframes hero-status { 50% { box-shadow: 0 0 0 6px #1d35ff00; opacity: .65; } }
  @media (min-width: 1440px) { .hero-introduction { max-width: 440px; } }
  @media (max-width: 1023px) { .hero-section { grid-template-columns: 43% 57%; } .hero-copy :global(.hero-title) { font-size: 42px; } .hero-actions { gap: 12px; } .hero-introduction { padding-right: 12px; } }
  @media (max-width: 767px) {
    .hero-frame { height: auto; min-height: 280px; aspect-ratio: 1.15; margin-top: 12px; }
    .hero-section { grid-template-columns: 1fr; padding-top: calc(var(--spacing-scroll-offset) + 16px); padding-bottom: 56px; }
    .hero-copy { padding: 12px 8px 20px; }
    .hero-copy :global(.hero-title) { margin-top: 22px; font-size: clamp(40px,10vw,62px); }
    .hero-introduction { margin-top: 24px; max-width: 460px; }
    .hero-introduction h2 { font-size: 18px; }
    .hero-introduction :global(.hero-bio) { font-size: 14px; }
    .hero-eyebrow { font-size: 9px; }
    .hero-actions { gap: 12px; margin-top: 24px; }
    .hero-socials { gap: 6px; }
    .hero-socials a { width: 36px; height: 36px; }
    .hero-explore { min-height: 46px; padding-inline: 16px; gap: 14px; }
    .hero-baseline { bottom: 0; font-size: 8px; padding-inline: 8px; }
  }
</style>
