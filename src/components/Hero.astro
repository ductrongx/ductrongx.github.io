---
import ArrowIcon from './ArrowIcon.astro';
import { profile } from '../data/profile';
const github = profile.links.find(link => link.label === 'GitHub');
---
<section id="about" class="hero-section" aria-labelledby="hero-title" data-hero data-scene data-tone="dark">
  <div class="hero-media" data-hero-media aria-hidden="true">
    <div class="prism-stage" data-prism-stage>
      <svg class="prism-fallback" viewBox="0 0 1400 1000" preserveAspectRatio="xMidYMid slice">
        <defs>
          <linearGradient id="prism-cyan"><stop stop-color="#039fff" stop-opacity="0"/><stop offset="1" stop-color="#8deaff" stop-opacity=".8"/></linearGradient>
          <linearGradient id="prism-gold" x2="0" y2="1"><stop stop-color="#ffe879" stop-opacity=".9"/><stop offset="1" stop-color="#50a4ff" stop-opacity="0"/></linearGradient>
          <linearGradient id="prism-glass" x2=".8" y2="1"><stop stop-color="#e0f8ff" stop-opacity=".55"/><stop offset=".3" stop-color="#16536a" stop-opacity=".1"/><stop offset=".8" stop-color="#b9ecff" stop-opacity=".2"/><stop offset="1" stop-color="#e9ffff" stop-opacity=".7"/></linearGradient>
          <filter id="prism-glow"><feGaussianBlur stdDeviation="14"/></filter>
        </defs>
        <g filter="url(#prism-glow)"><path d="M-100 280 850 410 840 445-100 380Z" fill="url(#prism-cyan)"/><path d="m1080-100 120 0-300 610-45-50Z" fill="url(#prism-gold)"/><path d="m800 410 70 15 320 690-170 0Z" fill="url(#prism-cyan)"/></g>
        <g fill="url(#prism-glass)" stroke="#bcecff" stroke-width="2">
          <path d="m650 220 310-50 165 150-309 66Z"/><path d="m650 220 166 166-15 348-169-167Z"/><path d="m816 386 309-66-23 342-301 72Z"/>
          <path d="m680 252 261-40 150 123-260 55Z"/><path d="m831 390 260-55-19 295-260 61Z"/>
          <path d="m717 319 227-38 100 100-229 44Z"/><path d="m815 425 229-44-14 214-228 49Z"/><path d="m717 319 98 106-13 219-99-104Z"/>
        </g>
        <g fill="none" stroke="#f0ffff" stroke-width="7" opacity=".65"><path d="m652 222 163 165-14 345"/><path d="m816 386 309-66-23 342"/></g>
      </svg>
      <canvas class="prism-canvas" data-prism-canvas></canvas>
    </div>
  </div>
  <div class="hero-shade" aria-hidden="true"></div>
  <div class="hero-content gallery-shell">
    <div class="hero-copy" data-hero-copy>
      <p class="hero-eyebrow"><span aria-hidden="true">↗</span> DUC / AI ENGINEER</p>
      <h1 id="hero-title">From context<br /><em>to intelligence.</em></h1>
      <div class="hero-actions flex flex-wrap items-center gap-6">
        <a class="pill-link hero-explore" href="#work" data-magnet><span>Explore the lab</span><ArrowIcon direction="down" /></a>
        {github && <a class="hero-github text-link" href={github.url} target="_blank" rel="noopener noreferrer"><span>GitHub</span><ArrowIcon /></a>}
      </div>
    </div>
    <div class="hero-aside">
      <span class="hero-orbit-mark" aria-hidden="true">D<span>↗</span></span>
      <p>I’m Duc. Exploring language models, retrieval and agent systems. Building what comes next.</p>
      <button type="button" class="hero-pause" data-prism-pause aria-pressed="false" hidden>Pause motion <span aria-hidden="true">Ⅱ</span></button>
    </div>
  </div>
  <div class="hero-baseline gallery-shell"><span>INDEPENDENT EXPLORATIONS / {new Date().getFullYear()}</span><span>CONTEXT <i>—</i> REASONING <i>—</i> ACTION</span><a href="#work" aria-label="Scroll to selected work">SCROLL TO DISCOVER <ArrowIcon direction="down" /></a></div>
</section>
<style>
  .hero-section { position: relative; isolation: isolate; overflow: clip; min-height: max(680px,100svh); display: flex; align-items: end; padding-top: var(--spacing-scroll-offset); padding-bottom: 116px; background: var(--color-night); color: var(--color-light-ink); transform-origin: 50% 50%; }
  .hero-media, .hero-shade { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .hero-media { transform-origin: 63% 40%; }
  .hero-shade { background: linear-gradient(0deg,var(--color-night) 2%,transparent 70%),linear-gradient(90deg,rgb(3 5 9 / .4),transparent 65%); }
  .prism-stage, .prism-fallback, .prism-canvas { width: 100%; height: 100%; }
  .prism-fallback, .prism-canvas { position: absolute; inset: 0; }
  .prism-canvas { display: block; opacity: 0; transition: opacity .8s; }
  .prism-stage[data-ready]:not([data-static]) .prism-canvas { opacity: 1; }
  .prism-stage[data-ready]:not([data-static]) .prism-fallback { opacity: 0; }
  .hero-content { display: grid; grid-template-columns: minmax(0,1fr) 240px; align-items: end; gap: 40px; position: relative; }
  .hero-copy { position: relative; }
  .hero-eyebrow { display: flex; align-items: center; gap: 12px; font-size: 10px; letter-spacing: .16em; }
  .hero-eyebrow span { color: var(--color-laser); font-size: 18px; }
  h1 { margin-top: 18px; font-size: clamp(60px,6.3vw,124px); line-height: .98; letter-spacing: -.065em; font-weight: 400; }
  h1 em { font-family: Georgia,'Times New Roman',serif; font-weight: 400; letter-spacing: -.065em; }
  .hero-actions { margin-top: 32px; }
  .hero-explore { background: var(--color-light-ink); color: var(--color-night); padding-inline: 26px; font-size: 13px; gap: 28px; }
  .hero-explore:hover { color: var(--color-light-ink); }
  .hero-github { color: var(--color-light-ink); font-size: 12px; }
  .hero-aside { padding-bottom: 4px; }
  .hero-aside p { margin-top: 20px; font-size: 13px; line-height: 1.8; color: var(--color-night-muted); }
  .hero-orbit-mark { width: 60px; height: 60px; border: 1px solid rgb(255 255 255 / .55); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 25px; font-family: Georgia,serif; }
  .hero-orbit-mark span { font-family: var(--font-sans); font-size: 16px; margin-left: 4px; color: var(--color-laser); }
  .hero-pause { min-height: 44px; margin-top: 8px; font-size: 10px; color: var(--color-night-muted); }
  .hero-pause span { margin-left: 14px; }
  .hero-baseline { display: flex; align-items: center; justify-content: space-between; gap: 16px; position: absolute; bottom: 22px; inset-inline: 0; border-top: 1px solid rgb(255 255 255 / .16); padding-top: 16px; font-size: 9px; letter-spacing: .1em; color: var(--color-night-muted); }
  .hero-baseline i { padding-inline: 10px; font-style: normal; color: var(--color-laser); }
  .hero-baseline a { display: flex; align-items: center; gap: 16px; min-height: 44px; color: var(--color-light-ink); }
  .hero-baseline svg { width: 16px; }
  @media (max-width: 1023px) { .hero-content { grid-template-columns: minmax(0,1fr) 200px; gap: 24px; } .hero-baseline > span:nth-child(2) { display: none; } h1 { font-size: clamp(52px,7vw,76px); } }
  @media (max-width: 767px) {
    .hero-section { min-height: 1000px; padding-bottom: 104px; }
    .hero-content { grid-template-columns: 1fr; gap: 20px; padding-top: 280px; }
    h1 { font-size: clamp(44px,9.8vw,74px); }
    .hero-aside { max-width: 340px; }
    .hero-aside p { margin-top: 0; font-size: 12px; }
    .hero-orbit-mark { display: none; }
    .hero-actions { margin-top: 24px; }
    .hero-baseline { font-size: 7px; bottom: 12px; }
    .hero-baseline a { font-size: 8px; gap: 8px; }
    .prism-fallback { object-position: 60% 0; }
  }
  @media (prefers-reduced-motion: reduce) { .hero-pause { display: none; } }
</style>
