---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Hero from '../components/Hero.astro';
import SlideText from '../components/SlideText.astro';
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import ContactLinks from '../components/ContactLinks.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { profile } from '../data/profile';
const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title={`${profile.name} — AI Engineer`} description={`The portfolio of ${profile.name}. Exploring AI engineering, language models and agentic systems.`}>
  <main id="main" class="home-page">
    <Hero />

    <section id="work" class="gallery-shell work-section" aria-labelledby="work-title">
      <div class="work-heading grid items-end gap-8 md:grid-cols-[1.4fr_1fr]">
        <div><p class="section-index mb-6" data-reveal>02 / Selected work</p><SlideText id="work-title" class="section-title" lines={['A few ideas.', 'A little further.']} /></div>
        <p class="work-description text-sm text-body" data-reveal>Experiments in retrieval, agents and human–AI interaction.<br />Concept projects for this portfolio preview.</p>
      </div>
      <div class="project-grid grid grid-cols-1 gap-x-project-column gap-y-project-row md:grid-cols-2">
        {projects.slice(0, 4).map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
      <div class="mt-12 flex justify-center"><a class="pill-link project-cta" href="/work/" data-magnet><span class="cta-arrow cta-arrow--in" aria-hidden="true"><ArrowIcon direction="right" /></span><span class="cta-label">VIEW ALL PROJECTS</span><span class="cta-arrow cta-arrow--out" aria-hidden="true"><ArrowIcon direction="right" /></span></a></div>
    </section>

    <section id="experience" class="gallery-shell experience-section" aria-labelledby="experience-title">
      <div class="grid gap-8 md:grid-cols-2">
        <p class="section-index" data-reveal>03 / Experience</p>
        <SlideText id="experience-title" class="journey-title" split="words" lines={['Learning, building.', 'Moving forward.']} />
      </div>
      <ExperienceTimeline />
    </section>

    <section id="blog" class="gallery-shell writing-section" aria-labelledby="blog-title">
      <div class="mb-12 flex flex-wrap items-end justify-between gap-8">
        <div><p class="section-index mb-6" data-reveal>04 / Blog</p><SlideText id="blog-title" class="section-title" motion="sweep" lines={['Thinking out loud.']} /></div>
        <a class="text-link" href="/blog/"><span>All blog posts</span><ArrowIcon /></a>
      </div>
      {posts.slice(0, 3).map(post => <a class="blog-row" href={`/blog/${post.id}/`} data-reveal><span class="section-index">{post.data.topic}</span><div><h3 class="text-2xl sm:text-3xl">{post.data.title}</h3><p class="mt-3 max-w-xl text-sm leading-relaxed">{post.data.description}</p><p class="mt-4 text-caption">{post.data.date.toLocaleDateString('en-GB', { timeZone: 'UTC' })}{post.data.sample && ' · Sample article'}</p></div><span class="round-link"><ArrowIcon /></span></a>)}
    </section>

    <section id="contact" class="contact-section" aria-labelledby="contact-title">
      <div class="gallery-shell contact-inner">
        <p class="section-index mb-6" data-reveal>05 / Contact</p>
        <div class="grid items-end gap-8 md:grid-cols-[1.4fr_1fr]">
          <SlideText id="contact-title" class="contact-title" motion="depth" lines={['Good things start', 'with a hello.']} />
          <p class="contact-description max-w-sm text-base leading-relaxed text-body" data-reveal>A question, an idea, or something you're working on. Find me around the web.</p>
        </div>
        <div class="contact-bottom"><ContactLinks /></div>
      </div>
    </section>
  </main>
</BaseLayout>
<style>
  .work-section { padding-top: clamp(100px,14vw,210px); }
  .work-heading { margin-bottom: 80px; }
  :global(.section-title) { font-size: var(--text-editorial); line-height: 1.08; letter-spacing: -.04em; }
  .work-description { justify-self: end; padding-bottom: 12px; line-height: 1.5; }
  .experience-section, .writing-section { padding-top: clamp(110px,13vw,180px); }
  .experience-section :global(.journey-title) { font-size: clamp(34px,3.6vw,64px); line-height: 1.13; letter-spacing: -.035em; }
  .contact-section { margin-top: clamp(100px,10vw,160px); padding-block: 48px clamp(72px,7vw,112px); }
  .contact-section :global(.contact-title) { font-size: clamp(34px,3.2vw,60px); line-height: 1.14; letter-spacing: -.035em; }
  .contact-description { justify-self: end; padding-bottom: 6px; }
  .contact-bottom { margin-top: 48px; }

  @media (max-width: 767px) {
    .work-heading { margin-bottom: 40px; }
    .work-description { justify-self: start; }
    .contact-section { padding-top: 24px; }
  .contact-section :global(.contact-title) { font-size: clamp(30px,7.5vw,42px); }
    .contact-description { justify-self: start; }
    .contact-bottom { margin-top: 36px; }
  }
</style>
