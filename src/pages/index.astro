---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Nguyen Trong Duc"
  description="Portfolio của Nguyen Trong Duc — AI Engineering, LLM và Agentic AI."
>
  <main class="mx-auto max-w-3xl px-6 py-12 sm:py-20">
    <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">Nguyen Trong Duc</h1>
    <p class="mt-3 text-lg text-slate-600">AI Engineering | LLM | Agentic AI</p>

    <section class="mt-10" aria-labelledby="portfolio-heading">
      <h2 id="portfolio-heading" class="text-2xl font-semibold">Portfolio của mình</h2>
      <p class="mt-3 leading-relaxed text-slate-600">Website đang chạy bằng GitHub Pages.</p>
    </section>
  </main>
</BaseLayout>
