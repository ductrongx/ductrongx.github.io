---
import {getCollection} from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
const posts=(await getCollection('blog',({data})=>!data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf());
---
<BaseLayout title="Blog — Nguyen Trong Duc" description="Notes and explorations in AI engineering.">
  <main id="main" class="gallery-shell min-h-[65vh] py-16 sm:py-24">
    <div class="mb-16 text-center" data-reveal>
      <p class="section-index">Blog / Explorations</p>
      <h1 class="mt-6 text-section leading-tight tracking-tight">Thinking out loud.</h1>
      <p class="mx-auto mt-6 max-w-lg leading-relaxed">Experiments, open questions and lessons from building.</p>
    </div>
    <div class="mx-auto max-w-5xl">{posts.map(post=><a class="blog-row" href={`/blog/${post.id}/`} data-reveal><span class="text-caption">{post.data.topic}</span><div><h2 class="text-2xl sm:text-3xl">{post.data.title}</h2><p class="mt-3 text-sm leading-relaxed">{post.data.description}</p>{post.data.sample&&<p class="mt-3 text-caption">Sample article</p>}</div><span class="round-link"><ArrowIcon /></span></a>)}</div>
  </main>
</BaseLayout>
